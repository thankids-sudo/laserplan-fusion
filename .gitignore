# Build output
.gradle/
build/
app/build/
local.properties
.idea/
*.iml
.DS_Store

# Never commit scans, survey archives, photos or point clouds
*.zip
LaserPlan-survey-*
*.xyzc
*.raw16le
*.raw8
*.jpg
*.jpeg

# Never commit credentials or signing keys
*.jks
*.keystore
*.p12
*.pem
keystore.properties
signing.properties
google-services.json

# AI model files are fetched by CI (official release + SHA-256), never committed
*.tflite
*.onnx
